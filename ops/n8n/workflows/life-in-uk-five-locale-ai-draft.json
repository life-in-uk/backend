        "jsCode": "const j = $input.first().json;\nif (j.adapterLabel !== 'LIVE_AI_PROVIDER_CALLS' || !j.job || !j.sourceGuide || !j.sourceRevisionId || !j.sourceContentHash || !Array.isArray(j.translations) || j.translations.length !== 4 || !Array.isArray(j.usageEvents) || j.usageEvents.length !== 6) throw new Error('Expected Sol policy analysis + Chinese draft + four Terra outputs and usage receipts');\nconst common = { batchId: j.batchId, sourceRevisionId: j.sourceRevisionId, sourceGuide: j.sourceGuide, sourceMaterials: j.sourceMaterials, generationMetrics: j.usageEvents };\nreturn [{ json: { ...common, locale: 'zh-CN', guide: j.sourceGuide, contentHash: j.sourceContentHash } }, ...j.translations.map(t => ({ json: { ...common, locale: t.locale, guide: t.guide } }))];"
