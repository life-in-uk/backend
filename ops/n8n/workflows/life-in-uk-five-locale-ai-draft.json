    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const detail = $input.first().json;\nconst rows = detail.locales || [];\nconst hashesMatch = rows.length === 5 && rows.every(r => r.validationStatus === 'VALID' && r.reviewStatus === 'PASSED' && r.contentHash === r.reviewedHash);\nconst generation = $('Sol 6.1 source + Terra 6.1 translations (local adapter)').first().json;\nconst reviews = $('Claude independent review (local adapter)').all().map(i => i.json.usageEvent).filter(Boolean);\nconst usageEvents = [...(generation.usageEvents || []), ...reviews];\nconst tokenValuesAvailable = usageEvents.length === 11 && usageEvents.every(u => Number.isSafeInteger(u.inputTokens) && Number.isSafeInteger(u.outputTokens));\nconst costsAvailable = usageEvents.length === 11 && usageEvents.every(u => Number.isFinite(u.estimatedCostUsd));\nreturn [{ json: { batchId: detail.batch?.batchId, status: detail.batch?.status, approvalGate: detail.batch?.status === 'READY' && hashesMatch ? 'WAITING_FOR_EXPLICIT_OWNER_APPROVAL' : 'NOT_READY', locales: rows.map(r => ({ locale: r.locale, contentHash: r.contentHash, reviewedHash: r.reviewedHash, review: r.reviewStatus, reviewer: r.reviewer })), publicationCalled: false, usageEvents, totalInputTokens: tokenValuesAvailable ? usageEvents.reduce((sum,u) => sum+u.inputTokens,0) : null, totalOutputTokens: tokenValuesAvailable ? usageEvents.reduce((sum,u) => sum+u.outputTokens,0) : null, estimatedApiCostUsd: costsAvailable ? Number(usageEvents.reduce((sum,u) => sum+u.estimatedCostUsd,0).toFixed(8)) : null } }];"
