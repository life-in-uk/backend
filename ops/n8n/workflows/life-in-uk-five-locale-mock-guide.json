        "jsCode": "const detail = $input.first().json;\nconst rows = detail.locales || [];\nconst hashesMatch = rows.length === 5 && rows.every(r => r.validationStatus === 'VALID' && r.reviewStatus === 'PASSED' && r.contentHash === r.reviewedHash);\nconst ready = detail.batch?.status === 'READY' && hashesMatch;\nconst mockOnly = rows.some(r => r.reviewer === 'mock-adapter');\nreturn [{ json: { batchId: detail.batch?.batchId, status: detail.batch?.status, approvalGate: mockOnly ? 'MOCK_ONLY_NOT_PUBLISHABLE' : (ready ? 'WAITING_FOR_EXPLICIT_OWNER_APPROVAL' : 'NOT_READY'), locales: rows.map(r => ({ locale: r.locale, hash: r.contentHash, review: r.reviewStatus, reviewer: r.reviewer })), publicationCalled: false, mockOnly } }];"
      },
