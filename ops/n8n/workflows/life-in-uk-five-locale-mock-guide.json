        "jsCode": "const rows = $input.all().map(i => i.json);\nconst ids = [...new Set(rows.map(r => r.batchId))];\nif (rows.length !== 5 || ids.length !== 1) throw new Error('Expected five review receipts for one batch');\nif (rows.some(r => r.reviewStatus !== 'PASSED' || r.reviewedHash !== r.contentHash)) throw new Error('A review is missing, failed, or stale');\nreturn [{ json: { batchId: ids[0] } }];"
