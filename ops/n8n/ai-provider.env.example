# Copy to a protected local file outside Git, then fill from verified provider contracts.
# Live provider calls are disabled unless AI_ADAPTER_ENABLED=true.
AI_ADAPTER_ENABLED=false
AI_ADAPTER_BIND=127.0.0.1
AI_ADAPTER_PORT=8092
AI_ADAPTER_TOKEN=REPLACE_WITH_RANDOM_LOCAL_ADAPTER_TOKEN_AT_LEAST_32_CHARS
AI_ADAPTER_TIMEOUT_MS=120000
AI_ADAPTER_MAX_PROCESSING_MS=900000
AI_ADAPTER_GENERATION_HTTP_TIMEOUT_MS=930000
AI_ADAPTER_MAX_REQUESTS_PER_MINUTE=12
AI_ADAPTER_ALLOW_HTTP_FOR_TESTS=false
AI_ADAPTER_METRICS_FILE=/REPLACE_WITH_ABSOLUTE_LOCAL_PATH/ai-usage.jsonl
AI_ADAPTER_IDEMPOTENCY_DIR=/REPLACE_WITH_ABSOLUTE_LOCAL_PATH/idempotency-claims

# Comma-separated official source host allowlist. Use exact host names where possible.
AI_SOURCE_ALLOWLIST=www.gov.uk

# Sol 6.1 adapter contract: OpenAI-compatible Chat Completions endpoint.
# Leave API URL, API key, and model ID empty until provider availability is confirmed.
SOL_PROVIDER_ID=sol
SOL_API_URL=
SOL_API_KEY=
SOL_MODEL_ID=
SOL_INPUT_USD_PER_MILLION=
SOL_OUTPUT_USD_PER_MILLION=
SOL_CACHED_INPUT_USD_PER_MILLION=
SOL_CACHE_WRITE_INPUT_USD_PER_MILLION=

# Terra 6.1 adapter contract: OpenAI-compatible Chat Completions endpoint.
TERRA_PROVIDER_ID=terra
TERRA_API_URL=
TERRA_API_KEY=
TERRA_MODEL_ID=
TERRA_INPUT_USD_PER_MILLION=
TERRA_OUTPUT_USD_PER_MILLION=
TERRA_CACHED_INPUT_USD_PER_MILLION=
TERRA_CACHE_WRITE_INPUT_USD_PER_MILLION=

# Claude independent review adapter contract: Anthropic-compatible Messages endpoint.
CLAUDE_API_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL_ID=
CLAUDE_API_VERSION=
CLAUDE_MAX_OUTPUT_TOKENS=4000
CLAUDE_INPUT_USD_PER_MILLION=
CLAUDE_OUTPUT_USD_PER_MILLION=
CLAUDE_CACHED_INPUT_USD_PER_MILLION=
CLAUDE_CACHE_WRITE_INPUT_USD_PER_MILLION=
