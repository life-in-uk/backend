# CloudFront → origin (deploy/RUNBOOK.md). Rendered at container start by the
# nginx image's envsubst step; only ${ORIGIN_SERVER_NAME} and
# ${ORIGIN_VERIFY_SECRET} (proxy.env) are substituted.
#
# Layers of origin protection, all required:
#   1. Security group: :443 only from the CloudFront origin-facing prefix list.
#   2. TLS: CloudFront connects with HTTPS only and validates this certificate.
#   3. X-Origin-Verify: the secret header only our distribution adds.
#   4. Allowlist: GET/HEAD on the public API, /sitemap.xml and /robots.txt;
#      owner and editorial APIs and everything else answer 404 here.

server_tokens off;
# The origin secret is 64 hex characters; the default bucket is too small for that map key.
map_hash_bucket_size 128;

map $http_x_origin_verify $origin_verified {
    default 0;
    "${ORIGIN_VERIFY_SECRET}" 1;
}

# Rate limits per viewer (CloudFront-Viewer-Address is "ip:port").
map $http_cloudfront_viewer_address $viewer_ip {
    "~^(?<ip>.+):[0-9]+$" $ip;
    default $remote_addr;
}
limit_req_zone $viewer_ip zone=api_viewer:10m rate=10r/s;
limit_req_zone $viewer_ip zone=places_viewer:10m rate=30r/m;
# Place search spends the OS Names quota: an overall cap as well.
limit_req_zone $server_name zone=places_all:1m rate=300r/m;
limit_req_status 429;

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${ORIGIN_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${ORIGIN_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ORIGIN_SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;
    ssl_session_timeout 1h;

    client_max_body_size 16k;
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types application/json application/xml text/plain text/xml;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $app http://app:8080;

    # nginx's own errors on API paths are JSON too; backend errors pass through unchanged.
    error_page 403 = @forbidden;
    error_page 404 = @not_found;
    error_page 429 = @rate_limited;
    location @forbidden    { default_type application/json; add_header Cache-Control no-store always; return 403 '{"code":"ORIGIN_FORBIDDEN"}'; }
    location @not_found    { default_type application/json; add_header Cache-Control no-store always; return 404 '{"code":"NOT_FOUND"}'; }
    location @rate_limited { default_type application/json; add_header Cache-Control no-store always; return 429 '{"code":"RATE_LIMITED"}'; }

    if ($origin_verified = 0) {
        return 403;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Origin-Verify "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    location = /sitemap.xml { limit_except GET HEAD { deny all; } proxy_pass $app; }
    location = /robots.txt  { limit_except GET HEAD { deny all; } proxy_pass $app; }

    location ^~ /api/owner/     { return 404; }
    location ^~ /api/editorial/ { return 404; }

    location = /api/places/search {
        limit_except GET HEAD { deny all; }
        limit_req zone=places_viewer burst=10 nodelay;
        limit_req zone=places_all burst=50 nodelay;
        proxy_pass $app;
    }

    location /api/ {
        limit_except GET HEAD { deny all; }
        limit_req zone=api_viewer burst=100 nodelay;
        proxy_pass $app;
    }

    location / {
        return 404;
    }
}
