#!/usr/bin/env python3
"""A stand-in for the AWS CLI, for deploy/test/ci-stack-test.sh. Never calls AWS.

SSM Run Command, exactly what deploy/ci/ssm-release.sh uses:
  aws ssm send-command --instance-ids I --document-name D --parameters JSON ... --query Command.CommandId --output text
  aws ssm get-command-invocation --command-id C --instance-id I --query Status|StandardOutputContent|StandardErrorContent --output text

send-command validates the parameters against infra/aws/ssm-backend-release.yml
(allowedValues, allowedPattern, defaults) like SSM does, substitutes them into
the document's runCommand, and runs it synchronously with bash, with
/opt/lifeinuk replaced by $LIFEINUK_DIR. State lives in $FAKE_AWS_STATE.

S3, exactly what deploy/scripts/common.sh s3_put_verified uses:
  aws s3api put-object --bucket B --key K --body F [--server-side-encryption AES256]
      [--checksum-algorithm SHA256] [--checksum-sha256 B64] [--metadata k=v,...] [--query ChecksumSHA256 --output text]

Like S3, it rejects the upload with BadDigest when --checksum-sha256 differs
from the SHA-256 of the bytes received, and otherwise stores the object
atomically under $FAKE_S3_DIR/B/K (with K.meta.json) and prints the checksum.
FAKE_S3_MODE simulates failures: "fail" (AccessDenied, nothing stored),
"corrupt" (one byte changes in transit), "misreport" (stored, but the response
reports another checksum).
"""
import base64
import hashlib
import json
import os
import re
import subprocess
import sys
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def opt(args, name):
    return args[args.index(name) + 1]


def fail(message, code=254, error="InvalidParameters", operation="SendCommand"):
    print(f"\nAn error occurred ({error}) when calling the {operation} operation: {message}", file=sys.stderr)
    sys.exit(code)


def put_object(args):
    bucket, key, body = opt(args, "--bucket"), opt(args, "--key"), Path(opt(args, "--body")).read_bytes()
    mode = os.environ.get("FAKE_S3_MODE", "ok")
    if mode == "fail":
        fail("Access Denied", error="AccessDenied", operation="PutObject")
    if mode == "corrupt":
        body = body[:-1] + bytes([body[-1] ^ 1])
    computed = base64.b64encode(hashlib.sha256(body).digest()).decode()
    if "--checksum-sha256" in args and opt(args, "--checksum-sha256") != computed:
        fail("Value for x-amz-checksum-sha256 header is invalid.", code=254, error="BadDigest", operation="PutObject")
    target = Path(os.environ["FAKE_S3_DIR"]) / bucket / key
    target.parent.mkdir(parents=True, exist_ok=True)
    meta = dict(item.split("=", 1) for item in opt(args, "--metadata").split(",")) if "--metadata" in args else {}
    (target.parent / f".{target.name}.tmp").write_bytes(body)
    (target.parent / f".{target.name}.tmp").rename(target)
    sse = opt(args, "--server-side-encryption") if "--server-side-encryption" in args else None
    target.with_name(target.name + ".meta.json").write_text(json.dumps({"Metadata": meta, "ServerSideEncryption": sse, "ChecksumSHA256": computed}))
    reported = base64.b64encode(hashlib.sha256(b"other").digest()).decode() if mode == "misreport" else computed
    if "--query" in args:
        print(reported if opt(args, "--query") == "ChecksumSHA256" else "None")
    else:
        print(json.dumps({"ETag": '"x"', "ChecksumSHA256": reported, "ServerSideEncryption": sse}))


args = sys.argv[1:]
if args[:2] == ["s3api", "put-object"]:
    put_object(args)
elif args[:2] == ["ssm", "send-command"]:
    import yaml
    DOCUMENT = yaml.safe_load((ROOT / "infra/aws/ssm-backend-release.yml").read_text())
    STATE = Path(os.environ["FAKE_AWS_STATE"])
    STATE.mkdir(parents=True, exist_ok=True)
    if opt(args, "--document-name") != os.environ.get("SSM_DOCUMENT", "LifeInUK-BackendRelease"):
        fail("unknown document")
    given = {key: value[0] for key, value in json.loads(opt(args, "--parameters")).items()}
    values = {}
    for name, spec in DOCUMENT["parameters"].items():
        value = given.pop(name, spec.get("default"))
        if value is None:
            fail(f"missing parameter {name}")
        if "allowedValues" in spec and value not in spec["allowedValues"]:
            fail(f"{name} is not an allowed value")
        if "allowedPattern" in spec and not re.fullmatch(spec["allowedPattern"], value):
            fail(f"{name} does not match {spec['allowedPattern']}")
        values[name] = value
    if given:
        fail(f"unknown parameters {sorted(given)}")
    script = "\n".join(DOCUMENT["mainSteps"][0]["inputs"]["runCommand"])
    script = re.sub(r"\{\{\s*(\w+)\s*\}\}", lambda m: values[m.group(1)], script)
    script = script.replace("/opt/lifeinuk", os.environ["LIFEINUK_DIR"])
    run = subprocess.run(["bash", "-c", script], capture_output=True, text=True)
    command_id = str(uuid.uuid4())
    (STATE / f"{command_id}.json").write_text(json.dumps({
        "Status": "Success" if run.returncode == 0 else "Failed",
        "StandardOutputContent": run.stdout[-24000:],
        "StandardErrorContent": run.stderr[-8000:],
    }))
    print(command_id)
elif args[:2] == ["ssm", "get-command-invocation"]:
    STATE = Path(os.environ["FAKE_AWS_STATE"])
    record = json.loads((STATE / f"{opt(args, '--command-id')}.json").read_text())
    print(record[opt(args, "--query")])
else:
    print(f"fake-aws: unsupported command {args[:2]}", file=sys.stderr)
    sys.exit(2)
