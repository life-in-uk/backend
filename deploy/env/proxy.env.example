# /etc/lifeinuk/proxy.env — environment of the nginx container (root:root, mode 0600).
# Generate the secret with: openssl rand -hex 32 (hex only: it is matched literally).
# The same value is configured as the custom origin header X-Origin-Verify on
# the CloudFront origin. Rotate both together (RUNBOOK.md "Secrets").

# Host name of the origin certificate; CloudFront's origin domain name.
ORIGIN_SERVER_NAME=origin.lifeinuk.info
ORIGIN_VERIFY_SECRET=
