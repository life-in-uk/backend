# /etc/lifeinuk/backup.env — read by lifeinuk-backup.service and by scripts/backup.sh
# itself, so release.sh and restore.sh use the same location (root:root, mode 0600). No secrets.
# Off-instance copy of every dump (S3, SSE-S3, SHA-256 verified by S3 on upload).
# The instance role may only PutObject under this prefix; the bucket's lifecycle
# rule for the prefix is the S3 retention. Required for releases: release.sh
# refuses to deploy without it. Empty = local copies only (nightly, restore).
BACKUP_S3_URI=s3://lifeinuk-backups-919693204623-eu-west-2/postgres/
# Local retention on the instance, in days.
BACKUP_KEEP_DAYS=14
