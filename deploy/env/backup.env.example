# /etc/lifeinuk/backup.env — read by lifeinuk-backup.service (root:root, mode 0600).
# Off-instance copy of each nightly dump (S3, SSE-S3). The instance role may
# only PutObject under this prefix. Leave empty to keep local copies only.
BACKUP_S3_URI=s3://<backup bucket>/db/
# Local retention on the instance, in days.
BACKUP_KEEP_DAYS=14
