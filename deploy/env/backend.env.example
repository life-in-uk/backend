# /etc/lifeinuk/backend.env — environment of the app container (root:root, mode 0600).
# Copy this template, fill the values on the server, keep a copy in the password manager.
# Never commit the filled file. Generate secrets with: openssl rand -hex 32

# Database: the same value as APP_DB_PASSWORD in db.env. (DB_URL and DB_USERNAME are set in compose.yml.)
DB_PASSWORD=

# Canonical origin for sitemap.xml and robots.txt; must equal the frontend's PUBLIC_ORIGIN.
LIFE_IN_UK_PUBLIC_BASE_URL=https://lifeinuk.info

# Travel (approved for release 2026-11-18, docs/travel-release.md). Off by default; the release sets
# these with scripts/set-env.sh (keys are prompted for, never typed on a command line). Rail is
# switched on last, after the new image runs (travel-release.md, "Why Rail is switched on last").
RAIL_ACCESS_ENABLED=false
TRAVEL_REFRESH_UNDERGROUND_ENABLED=false
TRAVEL_REFRESH_ROADS_ENABLED=false
NATIONAL_RAIL_DEPARTURES_BASE_URL=

# Provider credentials (secrets).
NATIONAL_HIGHWAYS_API_KEY=
OS_NAMES_API_KEY=
NATIONAL_RAIL_API_KEY=
NATIONAL_RAIL_DEPARTURES_API_KEY=

# Editorial: deliberately NOT configured at launch. With these unset, every
# /api/editorial/** route answers 503 and owner login answers 503, in addition
# to being blocked by nginx and CloudFront. Production publishing (deploy/PUBLISHING.md)
# configures them only after owner approval, reachable through the SSH tunnel only.
# EDITORIAL_OWNER_DRAFT_PASSWORD=
# EDITORIAL_OWNER_APPROVAL_PASSWORD=
# EDITORIAL_OWNER_ORIGINS=http://127.0.0.1:18080
# EDITORIAL_SESSION_COOKIE_SECURE=false
# LIFE_IN_UK_EDITORIAL_REVIEW_TOKEN=
# Never set LIFE_IN_UK_EDITORIAL_LOCAL_REVIEW_TOKEN or the "local" Spring profile in production.
