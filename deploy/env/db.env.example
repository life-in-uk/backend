# /etc/lifeinuk/db.env — environment of the db container (root:root, mode 0600).
# Read by PostgreSQL's first initialisation only: changing it later does not
# change existing passwords (use ALTER ROLE, see RUNBOOK.md "Secrets").
# Generate with: openssl rand -hex 32

# Superuser "postgres": used only by the operator scripts inside the container.
POSTGRES_PASSWORD=
# Application role life_in_uk_app (deploy/db/init/01-app-role.sh); the same value as DB_PASSWORD in backend.env.
APP_DB_PASSWORD=
